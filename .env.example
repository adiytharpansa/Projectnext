# Server
PORT=3000
NODE_ENV=development

# Provider base URLs (override when domains change — Gogo/Samehadaku rotate often).
# Bentuk plural = daftar mirror dipisah koma, dicoba berurutan sampai berhasil.
GOGO_BASE_URLS=https://gogoanime3.net
#GOGO_BASE_URL=https://gogoanime3.net
GOGO_AJAX_URL=https://ajax.gogo-load.com
GOGOBY_BASE_URL=https://gogoanime.by
SAMEHADAKU_BASE_URLS=https://v2.samehadaku.how,https://samehadaku.how
#SAMEHADAKU_BASE_URL=https://v2.samehadaku.how

# HTTP client
HTTP_TIMEOUT_MS=15000
HTTP_MAX_REDIRECTS=5

# Debrid GRATIS (magnet → HTTP siap stream): akun gratis di torbox.app → Settings → API key.
# Kosong = endpoint /api/v1/debrid/* nonaktif dengan pesan petunjuk.
TORBOX_API_KEY=

# Cache (in-memory, seconds)
CACHE_TTL_SECONDS=300

# Kredensial client publik beta-API Crunchyroll (default bawaan memakai token
# publik tool pihak ketiga — bisa dicabut sewaktu-waktu, override bila perlu).
#CRUNCHYROLL_BASIC_TOKEN=

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# CORS (comma-separated origins, * = allow all)
CORS_ORIGIN=*
